      "namedRegex": "^/ethical\\-ai(?:/)?$"
    },
    {
      "page": "/incidents",
      "regex": "^/incidents(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/incidents(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
